+/*****************************************************************************/
+/* Maximum size of a reassembled message on a module dynamic virtual channel */
+#define MOD_DVC_MAX_MESSAGE_BYTES (4 * 1024 * 1024)
+
+/*****************************************************************************/
+static struct xrdp_mm *
+xrdp_mm_from_process_id(intptr_t id)
+{
+    struct xrdp_process *pro = (struct xrdp_process *)id;
+
+    if (pro == NULL || pro->wm == NULL)
+    {
+        return NULL;
+    }
+    return pro->wm->mm;
+}
+
+/*****************************************************************************/
+static struct xrdp_mm_mod_dvc *
+xrdp_mm_get_mod_dvc(struct xrdp_mm *self, int chan_id)
+{
+    if (self == NULL || chan_id < 1 || chan_id > 255)
+    {
+        return NULL;
+    }
+    return self->mod_dvcs[chan_id];
+}
+
+/*****************************************************************************/
+static void
+xrdp_mm_free_mod_dvc(struct xrdp_mm *self, int chan_id)
+{
+    struct xrdp_mm_mod_dvc *dvc = xrdp_mm_get_mod_dvc(self, chan_id);
+
+    if (dvc != NULL)
+    {
+        g_free(dvc->rx_data);
+        g_free(dvc);
+        self->mod_dvcs[chan_id] = NULL;
+    }
+}
+
+/*****************************************************************************/
+/* Closes the dynamic virtual channels of a module that is going away */
+static void
+xrdp_mm_close_mod_dvcs(struct xrdp_mm *self)
+{
+    int chan_id;
+
+    for (chan_id = 1; chan_id < 256; chan_id++)
+    {
+        if (self->mod_dvcs[chan_id] != NULL)
+        {
+            libxrdp_drdynvc_close(self->wm->session, chan_id);
+            xrdp_mm_free_mod_dvc(self, chan_id);
+        }
+    }
+}
+
+/*****************************************************************************/
+static void
+xrdp_mm_mod_dvc_deliver(struct xrdp_mm *self, int chan_id,
+                        char *data, int bytes)
+{
+    if (self->mod != NULL && self->mod->mod_drdynvc_data != NULL)
+    {
+        self->mod->mod_drdynvc_data(self->mod, chan_id, data, bytes);
+    }
+}
+
+/*****************************************************************************/
+/* open response from client going to the module */
+static int
+xrdp_mm_mod_drdynvc_open_response(intptr_t id, int chan_id,
+                                  int creation_status)
+{
+    struct xrdp_mm *self = xrdp_mm_from_process_id(id);
+
+    if (xrdp_mm_get_mod_dvc(self, chan_id) == NULL)
+    {
+        return 0;
+    }
+
+    if (self->mod != NULL && self->mod->mod_drdynvc_open_response != NULL)
+    {
+        self->mod->mod_drdynvc_open_response(self->mod, chan_id,
+                                             creation_status);
+    }
+
+    if (creation_status < 0)
+    {
+        /* the client refused to open the channel */
+        xrdp_mm_free_mod_dvc(self, chan_id);
+    }
+    return 0;
+}
+
+/*****************************************************************************/
+/* close response from client going to the module */
+static int
+xrdp_mm_mod_drdynvc_close_response(intptr_t id, int chan_id)
+{
+    struct xrdp_mm *self = xrdp_mm_from_process_id(id);
+
+    if (xrdp_mm_get_mod_dvc(self, chan_id) == NULL)
+    {
+        return 0;
+    }
+
+    if (self->mod != NULL && self->mod->mod_drdynvc_close_response != NULL)
+    {
+        self->mod->mod_drdynvc_close_response(self->mod, chan_id);
+    }
+
+    xrdp_mm_free_mod_dvc(self, chan_id);
+    return 0;
+}
+
+/*****************************************************************************/
+/* first fragment of a message from client going to the module */
+static int
+xrdp_mm_mod_drdynvc_data_first(intptr_t id, int chan_id, char *data,
+                               int bytes, int total_bytes)
+{
+    struct xrdp_mm *self = xrdp_mm_from_process_id(id);
+    struct xrdp_mm_mod_dvc *dvc = xrdp_mm_get_mod_dvc(self, chan_id);
+
+    if (dvc == NULL)
+    {
+        return 0;
+    }
+
+    g_free(dvc->rx_data);
+    dvc->rx_data = NULL;
+    dvc->rx_bytes = 0;
+    dvc->rx_total_bytes = 0;
+
+    if (bytes < 0 || total_bytes < bytes ||
+            total_bytes > MOD_DVC_MAX_MESSAGE_BYTES)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_mm_mod_drdynvc_data_first: bad message "
+            "size %d / %d on channel %d", bytes, total_bytes, chan_id);
+        return 0;
+    }
+
+    if (bytes == total_bytes)
+    {
+        xrdp_mm_mod_dvc_deliver(self, chan_id, data, bytes);
+        return 0;
+    }
+
+    dvc->rx_data = g_new(char, total_bytes);
+    if (dvc->rx_data == NULL)
+    {
+        return 1;
+    }
+    g_memcpy(dvc->rx_data, data, bytes);
+    dvc->rx_bytes = bytes;
+    dvc->rx_total_bytes = total_bytes;
+    return 0;
+}
+
+/*****************************************************************************/
+/* message (or following fragment) from client going to the module */
+static int
+xrdp_mm_mod_drdynvc_data(intptr_t id, int chan_id, char *data, int bytes)
+{
+    struct xrdp_mm *self = xrdp_mm_from_process_id(id);
+    struct xrdp_mm_mod_dvc *dvc = xrdp_mm_get_mod_dvc(self, chan_id);
+
+    if (dvc == NULL || bytes < 0)
+    {
+        return 0;
+    }
+
+    if (dvc->rx_data == NULL)
+    {
+        /* complete message */
+        xrdp_mm_mod_dvc_deliver(self, chan_id, data, bytes);
+        return 0;
+    }
+
+    if (bytes > dvc->rx_total_bytes - dvc->rx_bytes)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_mm_mod_drdynvc_data: fragment overflows "
+            "message on channel %d", chan_id);
+        g_free(dvc->rx_data);
+        dvc->rx_data = NULL;
+        return 0;
+    }
+
+    g_memcpy(dvc->rx_data + dvc->rx_bytes, data, bytes);
+    dvc->rx_bytes += bytes;
+
+    if (dvc->rx_bytes == dvc->rx_total_bytes)
+    {
+        char *message = dvc->rx_data;
+        int message_bytes = dvc->rx_bytes;
+
+        dvc->rx_data = NULL;
+        dvc->rx_bytes = 0;
+        dvc->rx_total_bytes = 0;
+        xrdp_mm_mod_dvc_deliver(self, chan_id, message, message_bytes);
+        g_free(message);
+    }
+    return 0;
+}
+
+/*****************************************************************************/
+static int
+server_drdynvc_open(struct xrdp_mod *mod, const char *name, int flags,
+                    int *chan_id)
+{
+    struct xrdp_wm *wm = (struct xrdp_wm *)(mod->wm);
+    struct xrdp_mm *self = wm->mm;
+    struct xrdp_drdynvc_procs procs;
+    int id = 0;
+
+    if (name == NULL || chan_id == NULL)
+    {
+        return 1;
+    }
+
+    if (!self->drdynvc_up)
+    {
+        return 2;
+    }
+
+    g_memset(&procs, 0, sizeof(procs));
+    procs.open_response = xrdp_mm_mod_drdynvc_open_response;
+    procs.close_response = xrdp_mm_mod_drdynvc_close_response;
+    procs.data_first = xrdp_mm_mod_drdynvc_data_first;
+    procs.data = xrdp_mm_mod_drdynvc_data;
+
+    if (libxrdp_drdynvc_open(wm->session, name, flags, &procs, &id) != 0 ||
+            id < 1 || id > 255)
+    {
+        LOG(LOG_LEVEL_ERROR, "server_drdynvc_open: could not open %s", name);
+        return 1;
+    }
+
+    xrdp_mm_free_mod_dvc(self, id);
+    self->mod_dvcs[id] = g_new0(struct xrdp_mm_mod_dvc, 1);
+    if (self->mod_dvcs[id] == NULL)
+    {
+        libxrdp_drdynvc_close(wm->session, id);
+        return 1;
+    }
+
+    *chan_id = id;
+    return 0;
+}
+
+/*****************************************************************************/
+static int
+server_drdynvc_close(struct xrdp_mod *mod, int chan_id)
+{
+    struct xrdp_wm *wm = (struct xrdp_wm *)(mod->wm);
+
+    if (xrdp_mm_get_mod_dvc(wm->mm, chan_id) == NULL)
+    {
+        return 1;
+    }
+
+    /* the entry is freed when the client confirms the close */
+    return libxrdp_drdynvc_close(wm->session, chan_id);
+}
+
+/*****************************************************************************/
+static int
+server_drdynvc_send(struct xrdp_mod *mod, int chan_id,
+                    const char *data, int data_bytes)
+{
+    /* [MS-RDPEDYC] maximum data per DYNVC_DATA_FIRST / DYNVC_DATA PDU as
+       accepted by libxrdp */
+    const int max_fragment = 1590;
+    struct xrdp_wm *wm = (struct xrdp_wm *)(mod->wm);
+    int offset;
+    int bytes;
+
+    if (xrdp_mm_get_mod_dvc(wm->mm, chan_id) == NULL ||
+            data == NULL || data_bytes <= 0)
+    {
+        return 1;
+    }
+
+    if (data_bytes <= max_fragment)
+    {
+        return libxrdp_drdynvc_data(wm->session, chan_id, data, data_bytes);
+    }
+
+    if (libxrdp_drdynvc_data_first(wm->session, chan_id, data, max_fragment,
+                                   data_bytes) != 0)
+    {
+        return 1;
+    }
+
+    for (offset = max_fragment; offset < data_bytes; offset += bytes)
+    {
+        bytes = MIN(data_bytes - offset, max_fragment);
+        if (libxrdp_drdynvc_data(wm->session, chan_id, data + offset,
+                                 bytes) != 0)
+        {
+            return 1;
+        }
+    }
+    return 0;
+}
+
 /*****************************************************************************/
 static void
 xrdp_mm_module_cleanup(struct xrdp_mm *self)
@@ -148,6 +457,9 @@ xrdp_mm_module_cleanup(struct xrdp_mm *self)
         }
     }
 
+    /* the module can no longer receive channel events */
+    xrdp_mm_close_mod_dvcs(self);
+
     if (self->mod_handle != 0)
