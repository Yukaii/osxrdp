diff --git a/libxrdp/xrdp_autodetect.c b/libxrdp/xrdp_autodetect.c
new file mode 100644
index 00000000..0afcff6a
--- /dev/null
+++ b/libxrdp/xrdp_autodetect.c
@@ -0,0 +1,605 @@
+/**
+ * xrdp: A Remote Desktop Protocol server.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * Continuous network auto-detection ([MS-RDPBCGR] 2.2.14) and
+ * heartbeat ([MS-RDPBCGR] 2.2.16), sent over the MCS message channel.
+ *
+ * The server periodically measures the round-trip time and the bandwidth
+ * (by bracketing normal traffic with Bandwidth Measure Start / Stop) and
+ * reports the results to the client with Network Characteristics Result
+ * PDUs, which clients show as the connection quality.
+ */
+
+#if defined(HAVE_CONFIG_H)
+#include <config_ac.h>
+#endif
+
+#include "libxrdp.h"
+#include "ms-rdpbcgr.h"
+#include "file.h"
+#include "string_calls.h"
+
+/* all times are in milliseconds */
+#define RTT_INTERVAL         1000
+#define RTT_TIMEOUT          10000
+#define BW_INTERVAL          5000
+#define BW_WINDOW            1000
+#define NETCHAR_INTERVAL     2000
+/* bandwidth samples with less traffic than this measure the idle
+   throughput rather than the available bandwidth, so they are ignored */
+#define BW_MIN_BYTES         (64 * 1024)
+
+/* The client shows a warning after count1 missed heartbeats and starts
+   auto-reconnect after count2. xrdp can block its main loop for a while
+   (e.g. while a module connects), so these are generous */
+#define HEARTBEAT_PERIOD_SEC 5
+#define HEARTBEAT_COUNT1     6
+#define HEARTBEAT_COUNT2     24
+
+/*****************************************************************************/
+static int
+time_diff(int later, int earlier)
+{
+    return (int)((unsigned int)later - (unsigned int)earlier);
+}
+
+/*****************************************************************************/
+static void
+read_config(struct xrdp_autodetect *self, const char *xrdp_ini)
+{
+    struct list *items;
+    struct list *values;
+    int index;
+
+    if (xrdp_ini == NULL)
+    {
+        return;
+    }
+
+    items = list_create();
+    items->auto_free = 1;
+    values = list_create();
+    values->auto_free = 1;
+    file_by_name_read_section(xrdp_ini, "globals", items, values);
+
+    for (index = 0; index < items->count; index++)
+    {
+        const char *item = (const char *)list_get_item(items, index);
+        const char *value = (const char *)list_get_item(values, index);
+
+        if (g_strcasecmp(item, "network_autodetect") == 0)
+        {
+            self->autodetect_enabled = g_text2bool(value);
+        }
+        else if (g_strcasecmp(item, "heartbeat") == 0)
+        {
+            self->heartbeat_enabled = g_text2bool(value);
+        }
+    }
+
+    list_delete(items);
+    list_delete(values);
+}
+
+/*****************************************************************************/
+struct xrdp_autodetect *
+xrdp_autodetect_create(struct xrdp_sec *owner, const char *xrdp_ini)
+{
+    struct xrdp_autodetect *self;
+
+    self = g_new0(struct xrdp_autodetect, 1);
+    if (self == NULL)
+    {
+        return NULL;
+    }
+
+    self->sec_layer = owner;
+    self->autodetect_enabled = 1;
+    self->heartbeat_enabled = 1;
+    self->heartbeat_period = HEARTBEAT_PERIOD_SEC;
+    self->heartbeat_count1 = HEARTBEAT_COUNT1;
+    self->heartbeat_count2 = HEARTBEAT_COUNT2;
+    read_config(self, xrdp_ini);
+
+    return self;
+}
+
+/*****************************************************************************/
+void
+xrdp_autodetect_delete(struct xrdp_autodetect *self)
+{
+    g_free(self);
+}
+
+/*****************************************************************************/
+/* returns boolean */
+static int
+is_session_active(struct xrdp_autodetect *self)
+{
+    struct xrdp_rdp *rdp = self->sec_layer->rdp_layer;
+
+    return self->sec_layer->mcs_layer->msgchan_id != 0 &&
+           rdp->session != NULL && rdp->session->up_and_running;
+}
+
+/*****************************************************************************/
+/* returns boolean */
+static int
+client_supports(struct xrdp_autodetect *self, int early_capability_flag)
+{
+    struct xrdp_client_info *client_info =
+        &(self->sec_layer->rdp_layer->client_info);
+
+    return (client_info->mcs_early_capability_flags & early_capability_flag) != 0;
+}
+
+/*****************************************************************************/
+/* Sends a PDU on the MCS message channel with a basic security header.
+   returns error */
+static int
+send_message_channel_pdu(struct xrdp_autodetect *self, int sec_flags,
+                         const char *data, int data_len)
+{
+    struct xrdp_mcs *mcs = self->sec_layer->mcs_layer;
+    struct stream *s;
+    int rv;
+
+    make_stream(s);
+    init_stream(s, 8192);
+
+    if (xrdp_mcs_init(mcs, s) != 0)
+    {
+        free_stream(s);
+        return 1;
+    }
+
+    /* TS_SECURITY_HEADER */
+    out_uint16_le(s, sec_flags); /* flags */
+    out_uint16_le(s, 0); /* flagsHi */
+    out_uint8a(s, data, data_len);
+    s_mark_end(s);
+
+    rv = xrdp_mcs_send(mcs, s, mcs->msgchan_id);
+    free_stream(s);
+
+    if (rv != 0)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_autodetect: xrdp_mcs_send failed");
+    }
+    return rv;
+}
+
+/*****************************************************************************/
+/* Auto-Detect Request PDU with no extra fields ([MS-RDPBCGR] 2.2.14.1.1,
+   2.2.14.1.2, 2.2.14.1.4). returns error */
+static int
+send_request(struct xrdp_autodetect *self, int request_type,
+             int *out_sequence_number)
+{
+    char pdu[6];
+    int sequence_number = self->sequence_number++ & 0xffff;
+
+    pdu[0] = 0x06; /* headerLength */
+    pdu[1] = TYPE_ID_AUTODETECT_REQUEST; /* headerTypeId */
+    pdu[2] = (char)(sequence_number & 0xff); /* sequenceNumber */
+    pdu[3] = (char)((sequence_number >> 8) & 0xff);
+    pdu[4] = (char)(request_type & 0xff); /* requestType */
+    pdu[5] = (char)((request_type >> 8) & 0xff);
+
+    if (out_sequence_number != NULL)
+    {
+        *out_sequence_number = sequence_number;
+    }
+
+    return send_message_channel_pdu(self, SEC_AUTODETECT_REQ, pdu, sizeof(pdu));
+}
+
+/*****************************************************************************/
+static void
+write_uint32_le(char *p, unsigned int value)
+{
+    p[0] = (char)(value & 0xff);
+    p[1] = (char)((value >> 8) & 0xff);
+    p[2] = (char)((value >> 16) & 0xff);
+    p[3] = (char)((value >> 24) & 0xff);
+}
+
+/*****************************************************************************/
+/* Network Characteristics Result PDU ([MS-RDPBCGR] 2.2.14.1.5)
+   returns error */
+static int
+send_network_characteristics(struct xrdp_autodetect *self)
+{
+    char pdu[18];
+    int len = 6;
+    int request_type;
+    int sequence_number = self->sequence_number++ & 0xffff;
+    int base_rtt = 0;
+    int bandwidth = 0;
+    int index;
+
+    if (self->rtt_sample_count == 0)
+    {
+        return 0;
+    }
+
+    base_rtt = self->rtt_samples[0];
+    for (index = 1; index < self->rtt_sample_count; index++)
+    {
+        if (self->rtt_samples[index] < base_rtt)
+        {
+            base_rtt = self->rtt_samples[index];
+        }
+    }
+
+    /* throughput samples underestimate the available bandwidth, so report
+       the best recent one */
+    for (index = 0; index < self->bw_sample_count; index++)
+    {
+        if (self->bw_samples[index] > bandwidth)
+        {
+            bandwidth = self->bw_samples[index];
+        }
+    }
+
+    request_type = bandwidth > 0 ? RDP_NETCHAR_RESULT_BASE_RTT_BW_AVG_RTT
+                   : RDP_NETCHAR_RESULT_BASE_RTT_AVG_RTT;
+
+    write_uint32_le(pdu + len, base_rtt); /* baseRTT */
+    len += 4;
+    if (bandwidth > 0)
+    {
+        write_uint32_le(pdu + len, bandwidth); /* bandwidth (kbit/s) */
+        len += 4;
+    }
+    write_uint32_le(pdu + len, self->average_rtt); /* averageRTT */
+    len += 4;
+
+    pdu[0] = (char)len; /* headerLength */
+    pdu[1] = TYPE_ID_AUTODETECT_REQUEST; /* headerTypeId */
+    pdu[2] = (char)(sequence_number & 0xff); /* sequenceNumber */
+    pdu[3] = (char)((sequence_number >> 8) & 0xff);
+    pdu[4] = (char)(request_type & 0xff); /* requestType */
+    pdu[5] = (char)((request_type >> 8) & 0xff);
+
+    LOG_DEVEL(LOG_LEVEL_DEBUG, "xrdp_autodetect: baseRTT %d averageRTT %d "
+              "bandwidth %d kbit/s", base_rtt, self->average_rtt, bandwidth);
+
+    return send_message_channel_pdu(self, SEC_AUTODETECT_REQ, pdu, len);
+}
+
+/*****************************************************************************/
+/* Heartbeat PDU ([MS-RDPBCGR] 2.2.16.1) returns error */
+static int
+send_heartbeat(struct xrdp_autodetect *self)
+{
+    char pdu[4];
+
+    pdu[0] = 0; /* reserved */
+    pdu[1] = (char)self->heartbeat_period; /* period */
+    pdu[2] = (char)self->heartbeat_count1; /* count1 */
+    pdu[3] = (char)self->heartbeat_count2; /* count2 */
+
+    return send_message_channel_pdu(self, SEC_HEARTBEAT, pdu, sizeof(pdu));
+}
+
+/*****************************************************************************/
+static void
+add_rtt_sample(struct xrdp_autodetect *self, int rtt)
+{
+    if (rtt < 0)
+    {
+        return;
+    }
+
+    self->rtt_samples[self->rtt_sample_index] = rtt;
+    self->rtt_sample_index =
+        (self->rtt_sample_index + 1) % XRDP_AUTODETECT_RTT_SAMPLES;
+    if (self->rtt_sample_count < XRDP_AUTODETECT_RTT_SAMPLES)
+    {
+        self->rtt_sample_count++;
+    }
+
+    if (self->rtt_sample_count == 1)
+    {
+        self->average_rtt = rtt;
+    }
+    else
+    {
+        self->average_rtt = (self->average_rtt * 7 + rtt) / 8;
+    }
+}
+
+/*****************************************************************************/
+static void
+add_bw_sample(struct xrdp_autodetect *self, int kbps)
+{
+    if (kbps <= 0)
+    {
+        return;
+    }
+
+    self->bw_samples[self->bw_sample_index] = kbps;
+    self->bw_sample_index =
+        (self->bw_sample_index + 1) % XRDP_AUTODETECT_BW_SAMPLES;
+    if (self->bw_sample_count < XRDP_AUTODETECT_BW_SAMPLES)
+    {
+        self->bw_sample_count++;
+    }
+}
+
+/*****************************************************************************/
+/* Processes a PDU received on the MCS message channel.
+   returns error */
+int
+xrdp_autodetect_process(struct xrdp_autodetect *self, struct stream *s,
+                        int sec_flags)
+{
+    int header_length;
+    int header_type_id;
+    int sequence_number;
+    int response_type;
+    unsigned int time_delta;
+    unsigned int byte_count;
+    unsigned int bandwidth;
+    unsigned int rtt;
+
+    if (self == NULL)
+    {
+        return 1;
+    }
+
+    if ((sec_flags & SEC_AUTODETECT_RSP) == 0)
+    {
+        LOG_DEVEL(LOG_LEVEL_DEBUG, "xrdp_autodetect: ignoring message "
+                  "channel PDU with flags 0x%4.4x", sec_flags);
+        return 0;
+    }
+
+    /* [MS-RDPBCGR] 2.2.14.2 AUTODETECT_RSP_PDU */
+    if (!s_check_rem_and_log(s, 6, "Parsing [MS-RDPBCGR] AUTODETECT_RSP_PDU"))
+    {
+        return 1;
+    }
+    in_uint8(s, header_length);
+    in_uint8(s, header_type_id);
+    in_uint16_le(s, sequence_number);
+    in_uint16_le(s, response_type);
+
+    if (header_type_id != TYPE_ID_AUTODETECT_RESPONSE)
+    {
+        return 0;
+    }
+
+    switch (response_type)
+    {
+        case RDP_RTT_RESPONSE_TYPE:
+            if (self->rtt_pending &&
+                    sequence_number == self->rtt_sequence_number)
+            {
+                add_rtt_sample(self, time_diff(g_time3(), self->rtt_sent_time));
+                self->rtt_pending = 0;
+            }
+            break;
+
+        case RDP_BW_RESULTS_RESPONSE_TYPE_CONNECTTIME:
+        case RDP_BW_RESULTS_RESPONSE_TYPE_CONTINUOUS:
+            if (header_length < 0x0E ||
+                    !s_check_rem_and_log(s, 8, "Parsing [MS-RDPBCGR] "
+                                         "Bandwidth Measure Results"))
+            {
+                return 1;
+            }
+            in_uint32_le(s, time_delta);
+            in_uint32_le(s, byte_count);
+            if (time_delta > 0 && byte_count >= BW_MIN_BYTES)
+            {
+                /* bytes per ms * 8 = kbit/s */
+                add_bw_sample(self, (int)MIN((unsigned long long)byte_count * 8 / time_delta,
+                                             0x7fffffffULL));
+            }
+            break;
+
+        case RDP_NETCHAR_SYNC_RESPONSE_TYPE:
+            /* [MS-RDPBCGR] 2.2.14.2.3 values cached by the client from an
+               earlier connection, used until we have our own */
+            if (header_length < 0x0E ||
+                    !s_check_rem_and_log(s, 8, "Parsing [MS-RDPBCGR] "
+                                         "Network Characteristics Sync"))
+            {
+                return 1;
+            }
+            in_uint32_le(s, bandwidth);
+            in_uint32_le(s, rtt);
+            if (self->bw_sample_count == 0)
+            {
+                add_bw_sample(self, (int)MIN(bandwidth, 0x7fffffffU));
+            }
+            if (self->rtt_sample_count == 0)
+            {
+                add_rtt_sample(self, (int)MIN(rtt, 0x7fffffffU));
+            }
+            break;
+
+        default:
+            LOG_DEVEL(LOG_LEVEL_DEBUG, "xrdp_autodetect: ignoring response "
+                      "type 0x%4.4x", response_type);
+            break;
+    }
+
+    return 0;
+}
+
+/*****************************************************************************/
+/* returns boolean */
+static int
+autodetect_active(struct xrdp_autodetect *self)
+{
+    return self->autodetect_enabled &&
+           client_supports(self, RNS_UD_CS_SUPPORT_NETCHAR_AUTODETECT);
+}
+
+/*****************************************************************************/
+/* returns boolean */
+static int
+heartbeat_active(struct xrdp_autodetect *self)
+{
+    return self->heartbeat_enabled &&
+           client_supports(self, RNS_UD_CS_SUPPORT_HEARTBEAT_PDU);
+}
+
+/*****************************************************************************/
+static void
+update_timeout(int now, int due, int *timeout)
+{
+    int wait = time_diff(due, now);
+
+    if (wait < 0)
+    {
+        wait = 0;
+    }
+    if (*timeout < 0 || wait < *timeout)
+    {
+        *timeout = wait;
+    }
+}
+
+/*****************************************************************************/
+/* Lowers *timeout (ms, -1 = infinite) so the main loop wakes up when the
+   next PDU is due. returns error */
+int
+xrdp_autodetect_get_timeout(struct xrdp_autodetect *self, int *timeout)
+{
+    int now;
+
+    if (self == NULL || timeout == NULL || !is_session_active(self))
+    {
+        return 0;
+    }
+
+    if (!self->timers_started)
+    {
+        /* started by the next xrdp_autodetect_check_timers() */
+        *timeout = 0;
+        return 0;
+    }
+
+    now = g_time3();
+
+    if (autodetect_active(self))
+    {
+        update_timeout(now, self->next_rtt_time, timeout);
+        update_timeout(now, self->next_bw_time, timeout);
+        update_timeout(now, self->next_netchar_time, timeout);
+    }
+
+    if (heartbeat_active(self))
+    {
+        update_timeout(now, self->next_heartbeat_time, timeout);
+    }
+
+    return 0;
+}
+
+/*****************************************************************************/
+/* Sends any auto-detect / heartbeat PDUs that are due. returns error */
+int
+xrdp_autodetect_check_timers(struct xrdp_autodetect *self)
+{
+    int now;
+
+    if (self == NULL || !is_session_active(self))
+    {
+        return 0;
+    }
+
+    now = g_time3();
+
+    if (!self->timers_started)
+    {
+        /* g_time3() is wall clock time truncated to an int, so it can be
+           any value. Start every timer relative to now */
+        self->timers_started = 1;
+        self->next_heartbeat_time = now;
+        self->next_rtt_time = now;
+        self->next_bw_time = now + BW_INTERVAL;
+        self->next_netchar_time = now + NETCHAR_INTERVAL;
+    }
+
+    if (heartbeat_active(self) && time_diff(now, self->next_heartbeat_time) >= 0)
+    {
+        if (send_heartbeat(self) != 0)
+        {
+            return 1;
+        }
+        self->next_heartbeat_time = now + self->heartbeat_period * 1000;
+    }
+
+    if (!autodetect_active(self))
+    {
+        return 0;
+    }
+
+    if (time_diff(now, self->next_rtt_time) >= 0)
+    {
+        /* a lost response must not stop the measurements */
+        if (!self->rtt_pending ||
+                time_diff(now, self->rtt_sent_time) > RTT_TIMEOUT)
+        {
+            if (send_request(self, RDP_RTT_REQUEST_TYPE_CONTINUOUS,
+                             &self->rtt_sequence_number) != 0)
+            {
+                return 1;
+            }
+            self->rtt_pending = 1;
+            self->rtt_sent_time = now;
+        }
+        self->next_rtt_time = now + RTT_INTERVAL;
+    }
+
+    if (time_diff(now, self->next_bw_time) >= 0)
+    {
+        /* the client counts every byte it receives between Start and Stop
+           and replies with Bandwidth Measure Results */
+        if (send_request(self, self->bw_measuring
+                         ? RDP_BW_STOP_REQUEST_TYPE_CONTINUOUS
+                         : RDP_BW_START_REQUEST_TYPE_CONTINUOUS, NULL) != 0)
+        {
+            return 1;
+        }
+
+        if (self->bw_measuring)
+        {
+            self->bw_measuring = 0;
+            self->next_bw_time = now + BW_INTERVAL;
+        }
+        else
+        {
+            self->bw_measuring = 1;
+            self->next_bw_time = now + BW_WINDOW;
+        }
+    }
+
+    if (time_diff(now, self->next_netchar_time) >= 0)
+    {
+        if (send_network_characteristics(self) != 0)
+        {
+            return 1;
+        }
+        self->next_netchar_time = now + NETCHAR_INTERVAL;
+    }
+
+    return 0;
+}
